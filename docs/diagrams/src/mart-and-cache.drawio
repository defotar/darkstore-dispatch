oints"><mxPoint x="1000" y="503" /><mxPoint x="1000" y="419" /></Array></mxGeometry></mxCell><mxCell id="model_274" value="" style="rounded=0;html=1;endFill=0;startFill=0;strokeColor=#333333;jumpStyle=arc;jumpSize=8;startArrow=ERzeroToMany;endArrow=ERmandOne;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_fct_forecast_accuracy_forecast_type_id" target="r_dim_forecast_type_forecast_type_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="525" /><mxPoint x="1490" y="679" /></Array></mxGeometry></mxCell><mxCell id="model_275" value="Стереотипы по соглашению «Реляционные БД»: fct_ — факты (create_dttm), dim_ — измерения (create_dttm, modify_dttm, action_ind), dim_…_hist — измерения с историей (eff_dttm, exp_dttm), dm_ — агрегаты для потребителей. Связи — Crow's Foot: у каждой строки факта ровно одна строка измерения, у строки измерения ноль или много фактов." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1400" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cache" name="Схема кэширования"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="cache_1" value="Копия приложения кластера (у каждой из двух копий свой кэш)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B8FA3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="760" height="470" as="geometry" /></mxCell><mxCell id="cache_2" value="&lt;b&gt;Модуль «Местоположение и время в пути»&lt;/b&gt;&lt;br&gt;расчёт подачи (FR020, FR022)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="70" as="geometry" /></mxCell><mxCell id="cache_3" value="&lt;b&gt;Кэш «Время в пути»&lt;/b&gt;&lt;br&gt;[Caffeine, в памяти]&lt;br&gt;ключ: ячейка ~500 м + даркстор&lt;br&gt;read-through; обновление в фоне&lt;br&gt;через 12 мин, удаление через 60 мин,&lt;br&gt;до 50 000 записей, W-TinyLFU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="300" height="110" as="geometry" /></mxCell><mxCell id="cache_4" value="&lt;b&gt;Модуль «Интеграции»&lt;/b&gt;&lt;br&gt;запрос матрицы времён (И-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="300" height="60" as="geometry" /></mxCell><mxCell id="cache_5" value="&lt;b&gt;Модуль «Доступ и журналирование»&lt;/b&gt;&lt;br&gt;проверка токена (NFR004)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="70" as="geometry" /></mxCell><mxCell id="cache_6" value="&lt;b&gt;Кэш ключей проверки токена&lt;/b&gt;&lt;br&gt;[Spring Security, в памяти]&lt;br&gt;TTL 5 мин, повторный запрос&lt;br&gt;при неизвестном ключе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="300" height="90" as="geometry" /></mxCell><mxCell id="cache_7" value="&lt;b&gt;Модули ФП-1…ФП-5&lt;/b&gt;&lt;br&gt;заказы, смены, связки, решения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="300" height="60" as="geometry" /></mxCell><mxCell id="cache_8" value="&lt;b&gt;БД кластера&lt;/b&gt;&lt;br&gt;[PostgreSQL 16]&lt;br&gt;канонические данные,&lt;br&gt;без кэша: запросы 0,1–0,6 мс" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="260" height="100" as="geometry" /></mxCell><mxCell id="cache_9" value="&lt;b&gt;Исходящий шлюз&lt;/b&gt;&lt;br&gt;[Squid]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="260" height="60" as="geometry" /></mxCell><mxCell id="cache_10" value="&lt;b&gt;Сервис маршрутизации&lt;/b&gt;&lt;br&gt;[внешняя система, Интернет]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="200" width="260" height="60" as="geometry" /></mxCell><mxCell id="cache_11" value="&lt;b&gt;Сервер учётных записей сети&lt;/b&gt;&lt;br&gt;[смежная система]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="260" height="60" as="geometry" /></mxCell><mxCell id="cache_12" value="время в пути" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cache_2" target="cache_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cache_13" value="промах или фоновое обновление" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cache_3" target="cache_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cache_14" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cache_4" target="cache_9"><mxGeometry rela