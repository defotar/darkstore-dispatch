<mxfile host="drawio"><diagram id="flow" name="Поток витрины"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="flow_1" value="Источник" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B8FA3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="520" as="geometry" /></mxCell><mxCell id="flow_2" value="&lt;b&gt;БД кластера&lt;/b&gt;&lt;br&gt;[PostgreSQL 16, Patroni]&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;Факты схемы d05:&lt;br&gt;Lateness, DecisionLog,&lt;br&gt;DecisionOption, ForecastAccuracy&lt;br&gt;&lt;br&gt;Справочные данные для измерений:&lt;br&gt;d01 Darkstore, Subzone,&lt;br&gt;DeliveryOrder (ключ, подзона)&lt;br&gt;d02 Shift (ключ, базовый даркстор)&lt;br&gt;d04 Direction, DistributionParameter&lt;br&gt;d05 LatenessCauseDict&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="300" as="geometry" /></mxCell><mxCell id="flow_3" value="Публикация pub_mart: только INSERT и UPDATE, списки столбцов без персональных данных; удаление в источнике через 90 дней в витрину не передаётся" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="90" as="geometry" /></mxCell><mxCell id="flow_4" value="ELT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B8FA3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="300" height="520" as="geometry" /></mxCell><mxCell id="flow_5" value="&lt;b&gt;Логическая репликация&lt;/b&gt;&lt;br&gt;[PostgreSQL 16]&lt;br&gt;подписка sub_mart, слот с ограничением&lt;br&gt;max_slot_wal_keep_size" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="260" height="90" as="geometry" /></mxCell><mxCell id="flow_6" value="&lt;b&gt;Слой stg&lt;/b&gt;&lt;br&gt;копии строк источника,&lt;br&gt;хранятся 7 дней после загрузки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="260" height="70" as="geometry" /></mxCell><mxCell id="flow_7" value="&lt;b&gt;Ночная загрузка&lt;/b&gt;&lt;br&gt;[pg_cron, 03:00, SQL]&lt;br&gt;1. измерения SCD2&lt;br&gt;2. факты за 3 последних дня (upsert)&lt;br&gt;3. агрегаты dm_darkstore_day&lt;br&gt;4. проверки качества, журнал load_aud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="260" height="130" as="geometry" /></mxCell><mxCell id="flow_8" value="Витрина" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B8FA3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="300" height="520" as="geometry" /></mxCell><mxCell id="flow_9" value="&lt;b&gt;Витрина mart&lt;/b&gt;&lt;br&gt;[PostgreSQL 16, сервер базы трека]&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;Звезда:&lt;br&gt;fct_lateness, fct_decision,&lt;br&gt;fct_forecast_accuracy&lt;br&gt;dim_date, dim_darkstore_hist,&lt;br&gt;dim_parameter_hist, dim_lateness_cause,&lt;br&gt;dim_forecast_type&lt;br&gt;&lt;br&gt;Агрегаты: dm_darkstore_day&lt;br&gt;Хранение: два года&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="260" height="300" as="geometry" /></mxCell><mxCell id="flow_10" value="Потребители" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B8FA3;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="20" width="300" height="520" as="geometry" /></mxCell><mxCell id="flow_11" value="&lt;b&gt;Модуль «Контроль сроков»&lt;/b&gt;&lt;br&gt;[Spring Boot, API отчётов]&lt;br&gt;права по токену (NFR004)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3F7;strokeColor=#5B8FA3;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="60" width="260" height="80" as="geometry" /></mxCell><mxCell id="flow_12" value="&lt;b&gt;Рабочее место сети&lt;/b&gt;&lt;br&gt;[смежная система]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="190" width="260" height="60" as="geometry" /></mxCell><mxCell id="flow_13" value="&lt;b&gt;Руководитель операций сети&lt;/b&gt;&lt;br&gt;динамика опозданий и решений&lt;br&gt;по версиям порогов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="260" height="70" as="geometry" /></mxCell><mxCell id="flow_14" value="&lt;b&gt;Операционный аналитик&lt;/b&gt;&lt;br&gt;причины опозданий,&lt;br&gt;точность прогнозов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#888888;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="260" height="70" as="geometry" /></mxCell><mxCell id="flow_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow_2" target="flow_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow_5" target="flow_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow_6" target="flow_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_18" value="загрузка T+1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="flow_7" target="flow_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow_9" target="flow_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_20" value="оперативные отчёты d05 за 90 дней (FR044 и др.) — без витрины" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="flow_2" target="flow_11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="0" /><mxPoint x="1190" y="0" /></Array></mxGeometry></mxCell><mxCell id="flow_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow_11" target="flow_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5B8FA3;endArrow=block;end